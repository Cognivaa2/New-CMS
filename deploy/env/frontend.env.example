# Frontend env. The /api/v1 suffix is REQUIRED (the app calls `${BASE}/auth/login`,
# and socket.js strips /api/v1 off the base to get the socket origin).
#
# Local dev  -> Frontend/.env.local:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
#
# Hetzner (served same-origin behind nginx) -> Frontend/.env.production:
#   NEXT_PUBLIC_API_BASE_URL=http://204.168.223.223/api/v1
#
# Cloudflare Workers build (same-origin; /api proxied by the app's proxy/middleware):
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1
