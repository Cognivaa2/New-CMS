# Copy to /opt/newcms/Backend/.env on the server (or Backend/.env locally). Not committed.
NODE_ENV=production
LOG_LEVEL=info

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/new-cms

# Keycloak (backend talks to it server-side on localhost)
KEYCLOAK_URL=http://localhost:9090
KEYCLOAK_REALM=Test_Cms
KEYCLOAK_CLIENT_ID=cms-backend
KEYCLOAK_CLIENT_SECRET=__from_keycloak_admin__
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=__strong_random__

# Cloudflare R2 object storage — REQUIRED for any file/image upload.
# Without these, every multipart POST/PATCH (project cover, vendor photo,
# documents, avatars, attachments) 500s with "Resolved credential object is not
# valid". Create an R2 bucket, enable its public r2.dev URL, and make an R2 S3
# API token (dashboard -> R2 -> Manage API Tokens, Object Read & Write).
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=__r2_s3_access_key_id__
R2_SECRET_ACCESS_KEY=__r2_s3_secret_access_key__
R2_BUCKET_NAME=newcms
R2_PUBLIC_URL=https://<pub-xxxx>.r2.dev

# Optional (unused in the demo): SendGrid email
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
