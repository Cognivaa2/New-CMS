# Copy to /etc/newcms/keycloak.env on the server (referenced by keycloak.service). Not committed.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=__strong_random__
# KC 26 reads KC_BOOTSTRAP_ADMIN_*; these aliases keep older tooling happy too:
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__strong_random__
